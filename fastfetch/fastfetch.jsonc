 {
     "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": {
            "type": "auto",
            "source": "~/.config/hypr/wallpapers/katana.jpg",
	    "width": 25 ,
	    //"height": ,
	    "padding": {
	    	"top": 1,
		"bottom": 10,
		"left": 3,
		"right": 3
	    }
        },
        "display": {
            "separator": ": ",
	    "constants": [
			"__________",
			"_____",
			"               "
	    ],
	    "color": {
                "keys": "white",
                "title": "red"
            },
            "key": {
                "width": 9
            }
        },
        "modules": [
		{
			"type": "custom",
			"format": "{$3}"
		},

		{	
			"type": "custom",
			"padding":{
				"top": 2,
				"right": 3
			},
			"type":"custom",
			"format": "{$1}{$1} {#}system{#} {$1}{$1}"},
			{
				"type":"custom",
				"format":"{$3}"
			},
		"os",
		"kernel",
		"host",
		"uptime",
		"battery",
		{
			"type": "custom",
			"format": "{$1}{$1}_{$2}_{$1}{$1}"
		}
	]
    }
